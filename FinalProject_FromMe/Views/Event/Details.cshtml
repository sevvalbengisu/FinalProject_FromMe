@model FinalProject_FromMe.ViewModels.EventDetailViewModel

@{
    ViewData["Title"] = Model.Title;
    var joinLink = $"{Context.Request.Scheme}://{Context.Request.Host}/Event/Join/{Model.EventId}";
    var eventAccentClass = $"accent-{Model.EventId % 15}";
}

<div class="container mt-4">

    <div class="card shadow-sm mb-4 fromme-accent-card @eventAccentClass">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-bold mb-0">@Model.Title</h2>

                        @if (Model.IsPublic)
                        {
                            <span class="badge bg-success">Public</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Private by Link</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-2">@Model.Description</p>
                    }

                    <small class="text-muted">
                        Created by @Model.OwnerName · @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </small>
                </div>

                @if (Model.IsCurrentUserEventOwner)
                {
                    <a asp-controller="Event"
                       asp-action="Edit"
                       asp-route-id="@Model.EventId"
                       class="btn btn-outline-secondary btn-sm">
                        Edit Event
                    </a>
                }
            </div>

            <hr />

            <label class="form-label fw-semibold">Share event link</label>

            <div class="input-group">
                <input class="form-control" id="eventLinkInput" value="@joinLink" readonly />

                <button class="btn btn-outline-primary" type="button" onclick="copyEventLink()">
                    Copy Link
                </button>
            </div>

            <small class="text-muted">
                Share this link with guests. After login/register, they can post inside this event.
            </small>
        </div>
    </div>

    <div class="card shadow-sm mb-4" id="share-form">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Share something</h5>

            @if (TempData["PostError"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["PostError"]
                </div>
            }

            <form asp-controller="Post" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="NewPost.EventId" name="EventId" />

                <div class="mb-3">
                    <textarea asp-for="NewPost.Text"
                              name="Text"
                              class="form-control"
                              rows="3"
                              placeholder="Write a memory, message, or note..."></textarea>
                </div>

                <div class="mb-3">
                    <input asp-for="NewPost.Image"
                           name="Image"
                           class="form-control"
                           type="file"
                           accept="image/*" />

                    <small class="text-muted">
                        Allowed: jpg, jpeg, png, webp. Max size: 5 MB. Images wider than 1024px will be resized.
                    </small>
                </div>

                <button type="submit" class="btn btn-primary">
                    Post
                </button>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0">Event Posts</h4>
            <span class="text-muted">@Model.Posts.Count post(s)</span>
        </div>

        <div class="btn-group">
            <a asp-controller="Event"
               asp-action="Details"
               asp-route-id="@Model.EventId"
               asp-route-sort="newest"
               class="btn btn-sm @(Model.CurrentSort == "newest" ? "btn-primary" : "btn-outline-primary")">
                Newest
            </a>

            <a asp-controller="Event"
               asp-action="Details"
               asp-route-id="@Model.EventId"
               asp-route-sort="oldest"
               class="btn btn-sm @(Model.CurrentSort == "oldest" ? "btn-primary" : "btn-outline-primary")">
                Oldest
            </a>

            <a asp-controller="Event"
               asp-action="Details"
               asp-route-id="@Model.EventId"
               asp-route-sort="mostLiked"
               class="btn btn-sm @(Model.CurrentSort == "mostLiked" ? "btn-primary" : "btn-outline-primary")">
                Most Liked
            </a>
        </div>
    </div>

    @if (!Model.Posts.Any())
    {
        <div class="alert alert-light border">
            No posts yet. Be the first one to share something.
        </div>
    }
    else
    {
        <div class="masonry-grid">
            @foreach (var post in Model.Posts)
            {
                <div class="masonry-item" id="post-@post.Id">
                    <div class="card shadow-sm post-card fromme-accent-card @eventAccentClass">

                        @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                        {
                            <img src="@post.ImagePath"
                                 class="card-img-top"
                                 alt="Post image" />
                        }

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="small">@post.UserName</strong>

                                <div class="d-flex gap-2">
                                    @if (post.CanCurrentUserEdit)
                                    {
                                        <a asp-controller="Post"
                                           asp-action="Edit"
                                           asp-route-id="@post.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                    }

                                    @if (post.CanCurrentUserDelete)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-delete-x"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deletePostModal"
                                                data-post-id="@post.Id"
                                                title="Delete post"
                                                aria-label="Delete post">
                                            <span class="delete-x-symbol">×</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(post.Text))
                            {
                                <p class="card-text mb-1">
                                    @post.Text
                                </p>
                            }

                            <small class="text-muted d-block mb-3">
                                @post.CreatedAt.ToLocalTime().ToString("dd MMM")
                            </small>

                            <div class="d-flex align-items-center gap-2 mb-3">
                                <form asp-controller="Like" asp-action="Toggle" method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="postId" value="@post.Id" />
                                    <input type="hidden" name="eventId" value="@Model.EventId" />

                                    <button type="submit"
                                            class="btn btn-sm @(post.IsLikedByCurrentUser ? "btn-danger" : "btn-outline-danger")">
                                        @(post.IsLikedByCurrentUser ? "Unlike" : "Like")
                                    </button>
                                </form>

                                <span class="text-muted small">@post.LikeCount like(s)</span>
                            </div>

                            <div class="border-top pt-2">
                                <h6 class="fw-bold small">Comments</h6>

                                @if (!post.Comments.Any())
                                {
                                    <p class="text-muted small mb-2">No comments yet.</p>
                                }
                                else
                                {
                                    <div class="comments-box">
                                        @foreach (var comment in post.Comments)
                                        {
                                            <div class="mb-2 small">
                                                <strong>@comment.UserName:</strong>
                                                <span>@comment.Text</span>
                                                <br />
                                                <small class="text-muted">
                                                    @comment.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")
                                                </small>
                                            </div>
                                        }
                                    </div>
                                }

                                <form asp-controller="Comment" asp-action="Create" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="postId" value="@post.Id" />
                                    <input type="hidden" name="eventId" value="@Model.EventId" />

                                    <div class="input-group input-group-sm">
                                        <input type="text"
                                               name="text"
                                               class="form-control"
                                               placeholder="Comment..." />

                                        <button class="btn btn-outline-primary" type="submit">
                                            Send
                                        </button>
                                    </div>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="deletePostModal" tabindex="-1" aria-labelledby="deletePostModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deletePostModalLabel">Delete Post</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                Are you sure you want to delete this post?
                <br />
                <small class="text-muted">
                    This action cannot be undone.
                </small>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-controller="Post" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="postId" id="deletePostId" />
                    <input type="hidden" name="eventId" value="@Model.EventId" />

                    <button type="submit" class="btn btn-danger delete-confirm-button">
                        Yes, delete it
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    const scrollStorageKey = "frommeScrollPosition_@Model.EventId";

    if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
    }

    function copyEventLink() {
        const linkInput = document.getElementById("eventLinkInput");

        linkInput.select();
        linkInput.setSelectionRange(0, 99999);

        navigator.clipboard.writeText(linkInput.value);

        alert("Event link copied!");
    }

    const deletePostModal = document.getElementById("deletePostModal");

    if (deletePostModal) {
        deletePostModal.addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;
            const postId = button.getAttribute("data-post-id");

            document.getElementById("deletePostId").value = postId;
        });
    }

    function saveScrollPositionForForm(form) {
        let scrollInput = form.querySelector("input[name='returnScroll']");

        if (!scrollInput) {
            scrollInput = document.createElement("input");
            scrollInput.type = "hidden";
            scrollInput.name = "returnScroll";
            form.appendChild(scrollInput);
        }

        const currentScroll = Math.round(window.scrollY).toString();

        scrollInput.value = currentScroll;
        sessionStorage.setItem(scrollStorageKey, currentScroll);
    }

    document.addEventListener("submit", function (event) {
        if (event.target && event.target.tagName === "FORM") {
            saveScrollPositionForForm(event.target);
        }
    }, true);

    function getScrollTarget() {
        const urlParams = new URLSearchParams(window.location.search);
        const scrollFromUrl = urlParams.get("scroll");

        if (scrollFromUrl !== null) {
            return parseInt(scrollFromUrl);
        }

        const scrollFromStorage = sessionStorage.getItem(scrollStorageKey);

        if (scrollFromStorage !== null) {
            return parseInt(scrollFromStorage);
        }

        return null;
    }

    function cleanScrollUrl() {
        const url = new URL(window.location.href);

        if (url.searchParams.has("scroll")) {
            url.searchParams.delete("scroll");
            history.replaceState(null, "", url.pathname + url.search);
        }
    }

    function restoreScrollPosition() {
        const targetScroll = getScrollTarget();

        if (targetScroll === null || isNaN(targetScroll)) {
            return;
        }

        window.scrollTo(0, targetScroll);

        setTimeout(function () {
            window.scrollTo(0, targetScroll);
        }, 100);

        setTimeout(function () {
            window.scrollTo(0, targetScroll);
        }, 300);

        setTimeout(function () {
            window.scrollTo(0, targetScroll);
        }, 700);

        setTimeout(function () {
            cleanScrollUrl();
        }, 1000);
    }

    restoreScrollPosition();

    document.addEventListener("DOMContentLoaded", function () {
        restoreScrollPosition();
    });

    window.addEventListener("load", function () {
        restoreScrollPosition();
    });
</script>