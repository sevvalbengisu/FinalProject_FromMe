@model FinalProject_FromMe.ViewModels.EventDetailViewModel

@{
    ViewData["Title"] = Model.Title;
    var joinLink = $"{Context.Request.Scheme}://{Context.Request.Host}/Event/Join/{Model.EventId}";
}

<div class="container mt-4">

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap">
                <div>
                    <h2 class="fw-bold mb-1">@Model.Title</h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-2">@Model.Description</p>
                    }

                    <small class="text-muted">
                        Created by @Model.OwnerName · @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </small>
                </div>

                <a asp-controller="Event" asp-action="Index" class="btn btn-outline-secondary mt-2">
                    My Events
                </a>
            </div>

            <hr />

            <label class="form-label fw-semibold">Share event link</label>
            <input class="form-control" value="@joinLink" readonly />
            <small class="text-muted">
                Anyone who logs in and opens this link can view and share posts in this event.
            </small>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Share something</h5>

            <form asp-controller="Post" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="NewPost.EventId" name="EventId" />

                <div class="mb-3">
                    <textarea asp-for="NewPost.Text"
                              name="Text"
                              class="form-control"
                              rows="3"
                              placeholder="Write a memory, message, or note..."></textarea>
                </div>

                <div class="mb-3">
                    <input asp-for="NewPost.Image"
                           name="Image"
                           class="form-control"
                           type="file"
                           accept="image/*" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Post
                </button>
            </form>
        </div>
    </div>

    @if (!Model.Posts.Any())
    {
        <div class="alert alert-light border">
            No posts yet. Be the first one to share something.
        </div>
    }
    else
    {
        @foreach (var post in Model.Posts)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between">
                        <strong>@post.UserName</strong>
                        <small class="text-muted">
                            @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </small>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                {
                    <img src="@post.ImagePath" class="card-img-top" alt="Post image" />
                }

                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(post.Text))
                    {
                        <p class="card-text">@post.Text</p>
                    }

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <form asp-controller="Like" asp-action="Toggle" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="postId" value="@post.Id" />
                            <input type="hidden" name="eventId" value="@Model.EventId" />

                            <button type="submit" class="btn btn-sm @(post.IsLikedByCurrentUser ? "btn-danger" : "btn-outline-danger")">
                                @(post.IsLikedByCurrentUser ? "Unlike" : "Like")
                            </button>
                        </form>

                        <span class="text-muted">@post.LikeCount like(s)</span>
                    </div>

                    <hr />

                    <h6 class="fw-bold">Comments</h6>

                    @if (!post.Comments.Any())
                    {
                        <p class="text-muted small">No comments yet.</p>
                    }
                    else
                    {
                        @foreach (var comment in post.Comments)
                        {
                            <div class="mb-2">
                                <strong>@comment.UserName:</strong>
                                <span>@comment.Text</span>
                                <br />
                                <small class="text-muted">
                                    @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </small>
                            </div>
                        }
                    }

                    <form asp-controller="Comment" asp-action="Create" method="post" class="mt-3">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="postId" value="@post.Id" />
                        <input type="hidden" name="eventId" value="@Model.EventId" />

                        <div class="input-group">
                            <input type="text"
                                   name="text"
                                   class="form-control"
                                   placeholder="Write a comment..." />

                            <button class="btn btn-outline-primary" type="submit">
                                Comment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</div>