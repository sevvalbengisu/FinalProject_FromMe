@model List<FinalProject_FromMe.ViewModels.ExploreEventViewModel>

@{
    ViewData["Title"] = "Explore";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Explore Public Events</h2>
            <p class="text-muted mb-0">
                Discover public FromMe events and join the memories.
            </p>
        </div>

        <a asp-controller="Event" asp-action="Create" class="btn btn-primary">
            + Create Event
        </a>
    </div>

    <form asp-controller="Event" asp-action="Explore" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Search public events by title..." />

            <button class="btn btn-outline-primary" type="submit">
                Search
            </button>

            <a asp-controller="Event" asp-action="Explore" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-light border">
            No public events found.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var eventItem in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0">@eventItem.Title</h5>
                                <span class="badge bg-success">Public</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(eventItem.Description))
                            {
                                <p class="text-muted">
                                    @eventItem.Description
                                </p>
                            }
                            else
                            {
                                <p class="text-muted">
                                    No description.
                                </p>
                            }

                            <div class="text-muted small mt-auto">
                                Created by @eventItem.OwnerName
                                <br />
                                @eventItem.PostCount post(s)
                                <br />
                                Last activity:
                                @eventItem.LastActivityAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0">
                            <a asp-controller="Event"
                               asp-action="Details"
                               asp-route-id="@eventItem.EventId"
                               class="btn btn-outline-primary w-100">
                                Open Event
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>