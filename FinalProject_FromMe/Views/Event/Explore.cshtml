@model FinalProject_FromMe.ViewModels.ExploreIndexViewModel

@{
    ViewData["Title"] = "Explore";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Explore Public Events</h2>
            <p class="text-muted mb-0">
                Discover public FromMe events by event title or owner username.
            </p>
        </div>

        <a asp-controller="Event" asp-action="Create" class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Owner))
    {
        <div class="alert alert-light border d-flex justify-content-between align-items-center">
            <span>
                Showing public events created by <strong>@Model.Owner</strong>
            </span>

            <a asp-controller="Event" asp-action="Explore" class="btn btn-sm btn-outline-secondary">
                Clear owner filter
            </a>
        </div>
    }

    <form asp-controller="Event" asp-action="Explore" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Search by event title or owner username..." />

            <button class="btn btn-outline-primary" type="submit">
                Search
            </button>

            <a asp-controller="Event" asp-action="Explore" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>

    @if (!Model.Events.Any())
    {
        <div class="alert alert-light border">
            No public events found.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var eventItem in Model.Events)
            {
                var accentClass = $"accent-{eventItem.EventId % 5}";

                <div class="col-sm-6 col-lg-3">
                    <div class="card shadow-sm h-100 fromme-accent-card @accentClass">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="fw-bold mb-1 event-title">@eventItem.Title</h5>

                                    <small class="text-muted">
                                        Created by
                                        <a asp-controller="Event"
                                           asp-action="Explore"
                                           asp-route-owner="@eventItem.OwnerName"
                                           class="owner-link">
                                            @eventItem.OwnerName
                                        </a>
                                    </small>
                                </div>

                                <span class="badge bg-success">Public</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(eventItem.Description))
                            {
                                <p class="text-muted mt-3">
                                    @eventItem.Description
                                </p>
                            }
                            else
                            {
                                <p class="text-muted mt-3">
                                    No description.
                                </p>
                            }

                            <div class="text-muted small mt-auto">
                                @eventItem.PostCount post(s)
                                <br />
                                Last activity:
                                @eventItem.LastActivityAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0">
                            <a asp-controller="Event"
                               asp-action="Details"
                               asp-route-id="@eventItem.EventId"
                               class="btn btn-outline-primary w-100">
                                Open Event
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>