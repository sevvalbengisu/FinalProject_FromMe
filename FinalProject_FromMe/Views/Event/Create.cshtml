@model FinalProject_FromMe.ViewModels.EventCreateViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-2">Create a New Event</h2>
                    <p class="text-muted mb-4">
                        Start an event space where guests can share memories.
                    </p>

                    <form asp-controller="Event" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Event Title</label>
                            <input asp-for="Title" class="form-control" placeholder="Example: Graduation Night" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Write a short description for your event"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="IsPublic" class="form-label">Event Visibility</label>

                            <select asp-for="IsPublic" class="form-select">
                                <option value="false">Private by Link</option>
                                <option value="true">Public</option>
                            </select>

                            <small class="text-muted">
                                Private by Link events are only accessible with the event link.
                                Public events can appear on the Explore page.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Create Event
                        </button>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Event" asp-action="Index" class="text-decoration-none">
                    ← Back to My Events
                </a>
            </div>
        </div>
    </div>
</div>