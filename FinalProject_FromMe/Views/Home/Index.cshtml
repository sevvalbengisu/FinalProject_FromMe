@model FinalProject_FromMe.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">

    @if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <div class="row align-items-center mt-5">
            <div class="col-md-7">
                <h1 class="display-5 fw-bold">
                    FromMe
                </h1>

                <p class="lead text-muted">
                    Create event-based memory spaces where guests can share photos, messages, likes and comments.
                </p>

                <div class="mt-4">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">
                        Get Started
                    </a>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg">
                        Login
                    </a>
                </div>
            </div>

            <div class="col-md-5 mt-4 mt-md-0">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold">How it works</h5>

                        <ol class="text-muted mb-0">
                            <li>Create an event.</li>
                            <li>Share the event link with guests.</li>
                            <li>Guests join, post photos or notes.</li>
                            <li>Everyone inside the event can like and comment.</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-1">My Recent Posts</h2>
                <p class="text-muted mb-0">
                    Posts you shared inside FromMe events.
                </p>
            </div>

            <div>
                <a asp-controller="Event" asp-action="Explore" class="btn btn-outline-primary me-2">
                    Explore Public Events
                </a>

                <a asp-controller="Event" asp-action="Create" class="btn btn-primary">
                    + Create Event
                </a>
            </div>
        </div>

        @if (!Model.RecentPosts.Any())
        {
            <div class="alert alert-light border">
                You have not shared any posts yet. Open or create an event to share your first memory.
            </div>
        }
        else
        {
            <div class="masonry-grid">
                @foreach (var post in Model.RecentPosts)
                {
                    <div class="masonry-item">
                        <div class="card shadow-sm post-card">

                            @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                            {
                                <img src="@post.ImagePath"
                                     class="card-img-top"
                                     alt="Post image" />
                            }

                            <div class="card-body">
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <strong class="small">@post.UserName</strong>

                                        @if (post.EventIsPublic)
                                        {
                                            <span class="badge bg-success">Public</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Private Link</span>
                                        }
                                    </div>

                                    <small class="text-muted">
                                        in @post.EventTitle
                                    </small>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(post.Text))
                                {
                                    <p class="card-text">
                                        @post.Text
                                    </p>
                                }

                                <div class="text-muted small mb-3">
                                    @post.LikeCount like(s) · @post.CommentCount comment(s)
                                    <br />
                                    @post.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </div>

                                <a asp-controller="Event"
                                   asp-action="Details"
                                   asp-route-id="@post.EventId"
                                   class="btn btn-sm btn-outline-primary w-100">
                                    Open Event
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    }
</div>